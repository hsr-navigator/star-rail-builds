---
import { Image } from 'astro:assets';
import { t } from '../utils/i18n';
import { localizedPath } from '../utils/paths';
import physicalIcon from '../assets/browser-icons/types/physical.png';
import fireIcon from '../assets/browser-icons/types/fire.png';
import iceIcon from '../assets/browser-icons/types/ice.png';
import lightningIcon from '../assets/browser-icons/types/lightning.png';
import windIcon from '../assets/browser-icons/types/wind.png';
import quantumIcon from '../assets/browser-icons/types/quantum.png';
import imaginaryIcon from '../assets/browser-icons/types/imaginary.png';

import destructionIcon from '../assets/browser-icons/paths/destruction.png';
import huntIcon from '../assets/browser-icons/paths/hunt.png';
import eruditionIcon from '../assets/browser-icons/paths/erudition.png';
import harmonyIcon from '../assets/browser-icons/paths/harmony.png';
import nihilityIcon from '../assets/browser-icons/paths/nihility.png';
import preservationIcon from '../assets/browser-icons/paths/preservation.png';
import abundanceIcon from '../assets/browser-icons/paths/abundance.png';
import remembranceIcon from '../assets/browser-icons/paths/remembrance.png';
import elationIcon from '../assets/browser-icons/paths/elation.png';

const typeIcons = {
    physical: physicalIcon,
    fire: fireIcon,
    ice: iceIcon,
    lightning: lightningIcon,
    wind: windIcon,
    quantum: quantumIcon,
    imaginary: imaginaryIcon,
} as const;

const pathIcons = {
    destruction: destructionIcon,
    hunt: huntIcon,
    erudition: eruditionIcon,
    harmony: harmonyIcon,
    nihility: nihilityIcon,
    preservation: preservationIcon,
    abundance: abundanceIcon,
    remembrance: remembranceIcon,
    elation: elationIcon,
} as const;
const { characters, lang, locale } = Astro.props;

const characterCountLabel = t(locale, 'ui', 'Characters');
const noResultsLabel = t(locale, 'ui', 'No characters found');
const openBuildsLabel = t(locale, 'ui', 'Open builds');
const resultsLabel = t(locale, 'ui', 'Results');
const releaseDateLabel = t(locale, 'ui', 'Release date');
const newestLabel = t(locale, 'ui', 'Newest');
const latestUpdateLabel = t(locale, 'ui', 'Last Updated');
const characterPortraitAltTemplate = t(locale, 'ui', 'Character portrait alt');
const sortByLabel = t(locale, 'ui', 'Sort by');
const sortOptions = [
    {
        value: 'release',
        label: t(locale, 'ui', 'Release Date - Newest', undefined, false),
    },
    {
        value: 'updated',
        label: t(locale, 'ui', 'Last Updated - Newest', undefined, false),
    },
    {
        value: 'name',
        label: t(locale, 'ui', 'Characters - A-Z', undefined, false),
    },
    {
        value: 'type',
        label: t(locale, 'ui', 'Type - A-Z', undefined, false),
    },
    {
        value: 'rarity',
        label: t(locale, 'ui', 'Rarity - A-Z', undefined, false),
    },
];

function formatUiTemplate(template: string, name: string) {
    return template.replace('{name}', name);
}

function getCharacterViewModel(character: any) {
    const href = localizedPath(lang, character.slug);

    const typeLabel = t(locale, 'type', character.type);

    const pathLabel = t(locale, 'path', character.path);

    const rarityLabel = `${character.rarity}\u2605`;

    const typeIcon =
        typeIcons[character.type as keyof typeof typeIcons];

    const pathIcon = pathIcons[character.path as keyof typeof pathIcons];

    return {
        ...character,
        href,
        typeLabel,
        pathLabel,
        rarityLabel,
        typeIcon,
        pathIcon,
    };
}

const rosterCharacters: ReturnType<typeof getCharacterViewModel>[] =
    characters.map(getCharacterViewModel);
---

<section class="home-roster">
    <section class="roster-list-panel" aria-labelledby="character-roster-title">
        <div class="roster-list-header">
            <div>
                <h2 id="character-roster-title">{characterCountLabel}</h2>
                <p
                    data-character-count
                    data-results-label={resultsLabel}
                    aria-live="polite"
                >
                    {characters.length}
                    {resultsLabel}
                </p>
            </div>
            <label class="roster-sort">
                {sortByLabel}
                <select
                    class="home-native-select"
                    name="sort"
                    form="character-filters"
                    aria-label={sortByLabel}
                >
                    {
                        sortOptions.map((option) => (
                            <option
                                value={option.value}
                                selected={option.value === 'release'}
                            >
                                {option.label}
                            </option>
                        ))
                    }
                </select>
            </label>
        </div>

        <div class="roster-list" data-roster-list>
            {
                rosterCharacters.map((character) => {
                    const portraitAlt = formatUiTemplate(
                        characterPortraitAltTemplate,
                        character.name,
                    );

                    return (
                        <a
                            class={`roster-character ${character.type}${character.isWip ? ' is-wip' : ''}`}
                            href={character.isWip ? undefined : character.href}
                            aria-label={
                                character.isWip
                                    ? `${character.name}, WIP`
                                    : `${character.name}, ${character.pathLabel}. ${openBuildsLabel}`
                            }
                            aria-disabled={character.isWip ? 'true' : undefined}
                            data-character-card
                            data-type={character.type}
                            data-last-updated={character.lastUpdated}
                            data-name={character.name}
                            data-recent-updated={
                                character.isRecentlyUpdated ? 'true' : 'false'
                            }
                            data-rarity={character.rarity}
                            data-rarity-label={character.rarityLabel}
                            data-version-released={character.versionReleased}
                            data-path={character.path}
                        >
                            <span class="roster-character-art">
                                {character.portrait && (
                                    <Image
                                        src={character.portrait}
                                        alt={portraitAlt}
                                        loading="lazy"
                                        decoding="async"
                                        width={160}
                                        height={160}
                                        densities={[1, 2]}
                                    />
                                )}
                            </span>
                            <span
                                class="roster-character-emblems"
                                aria-hidden="true"
                            >
                                {character.typeIcon && (
                                    <img
                                        class="roster-character-emblem roster-character-emblem-type"
                                        src={character.typeIcon.src}
                                        alt=""
                                        title={character.typeLabel}
                                        width="28"
                                        height="28"
                                    />
                                )}

                                {character.pathIcon && (
                                    <img
                                        class="roster-character-emblem roster-character-emblem-path"
                                        src={character.pathIcon.src}
                                        alt=""
                                        title={character.pathLabel}
                                        width="30"
                                        height="30"
                                    />
                                )}
                            </span>

                            <span
                                class="roster-character-copy"
                                aria-hidden="true"
                            >
                                <span class="roster-character-name">
                                    {character.name}
                                </span>
                            </span>

                            {character.lastUpdated && (
                                <span
                                    class="roster-character-updated"
                                    aria-hidden="true"
                                >
                                    {character.lastUpdated}
                                </span>
                            )}
                        </a>
                    );
                })
            }
        </div>

        <p class="roster-empty" data-character-empty hidden>{noResultsLabel}</p>
    </section>
</section>
