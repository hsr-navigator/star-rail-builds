---
import { t } from '../utils/i18n';

type RenderedNote = {
    id: string;
    name: string;
    note: string;
};

type PrioritySection = {
    priority?: string;
    details?: string;
};

type OverviewData = {
    summary?: string;
    investment_priority?: PrioritySection;
    notable_eidolons?: PrioritySection;
};

type BuildNoteData = {
    notes?: string[];
    overview?: OverviewData;
};

const { notes, buildNote, locale } = Astro.props as {
    notes: any;
    buildNote?: BuildNoteData | null;
    locale: any;
};

const ui = (id: string) => t(locale, 'ui', id, undefined, false);

/*
 * Short / attached notes.
 * These stay in the NOTES card.
 */
const itemNotes: RenderedNote[] = [
    ...(notes?.lightCones?.items ?? []),

    ...(notes?.relics?.sets ?? []),
    ...(notes?.relics?.mainstats ?? []),
    ...(notes?.relics?.substats ?? []),

    ...(notes?.recommendedStats?.items ?? []),

    ...(notes?.traces?.items ?? []),
];

const globalNotes: string[] = [
    ...(notes?.lightCones?.global ?? []),
    ...(notes?.relics?.global ?? []),
    ...(notes?.recommendedStats?.global ?? []),
    ...(notes?.traces?.global ?? []),
];

const buildNotes: string[] = buildNote?.notes ?? [];

const hasNotes =
    itemNotes.length > 0 || globalNotes.length > 0 || buildNotes.length > 0;

/*
 * Long-form build overview.
 */
const overview = buildNote?.overview;

const hasSummary = Boolean(overview?.summary);

/*
 * investment_priority and notable_eidolons are intentionally
 * interchangeable. If both are present, investment_priority wins.
 */
const prioritySection = overview?.investment_priority
    ? {
          title: ui('Investment Priority'),
          data: overview.investment_priority,
      }
    : overview?.notable_eidolons
      ? {
            title: ui('Notable Eidolons'),
            data: overview.notable_eidolons,
        }
      : null;

const hasPrioritySection = Boolean(
    prioritySection?.data?.priority || prioritySection?.data?.details,
);

const hasOverview = hasSummary || hasPrioritySection;
---

{
    hasNotes && (
        <details class="card notes-card section-collapse" open>
            <summary class="section-collapse-summary">
                <h2>{ui('Notes')}</h2>

                <span class="section-collapse-chevron" aria-hidden="true" />
            </summary>

            <div class="section-collapse-body">
                <div class="notes-content">
                    {buildNotes.length > 0 && (
                        <div class="build-note-list">
                            {buildNotes.map((note) => (
                                <div class="build-note" set:html={note} />
                            ))}
                        </div>
                    )}

                    {globalNotes.length > 0 && (
                        <div class="notes-global-list">
                            {globalNotes.map((note) => (
                                <div class="note-global" set:html={note} />
                            ))}
                        </div>
                    )}

                    {itemNotes.length > 0 && (
                        <div class="note-list">
                            {itemNotes.map((note) => (
                                <div
                                    id={note.id}
                                    class="note-target"
                                    set:html={`<span class="type-bold">${note.name}:</span> ${note.note}`}
                                />
                            ))}
                        </div>
                    )}
                </div>
            </div>
        </details>
    )
}

{
    hasOverview && (
        <details class="card notes-card overview-card section-collapse" open>
            <summary class="section-collapse-summary">
                <h2>{ui('Overview')}</h2>

                <span class="section-collapse-chevron" aria-hidden="true" />
            </summary>

            <div class="section-collapse-body">
                <div class="overview-content">
                    {hasSummary && overview?.summary && (
                        <section class="overview-section">
                            <h3>{ui('Summary and General Analysis')}</h3>

                            <div
                                class="overview-text"
                                set:html={overview.summary}
                            />
                        </section>
                    )}

                    {hasPrioritySection && prioritySection && (
                        <section class="overview-section">
                            <h3>{prioritySection.title}</h3>

                            {prioritySection.data.priority && (
                                <div
                                    class="overview-investment-priority"
                                    set:html={prioritySection.data.priority}
                                />
                            )}

                            {prioritySection.data.details && (
                                <div
                                    class="overview-text"
                                    set:html={prioritySection.data.details}
                                />
                            )}
                        </section>
                    )}
                </div>
            </div>
        </details>
    )
}

<!--
    Note preview popup
    ------------------
    Hovering/focusing an ⓘ note link previews the matching note.
    Clicking the icon still follows the existing #note-id anchor.
-->
<div id="note-preview-popup" class="note-preview-popup" role="tooltip" hidden>
</div>

<script>
    const root = document.documentElement;

    if (root.dataset.notePreviewReady !== 'true') {
        root.dataset.notePreviewReady = 'true';

        const popup = document.querySelector<HTMLElement>(
            '#note-preview-popup',
        );

        let activeTrigger: HTMLElement | null = null;
        let showTimer: number | undefined;
        let hideTimer: number | undefined;

        const clearTimers = () => {
            if (showTimer !== undefined) {
                window.clearTimeout(showTimer);
                showTimer = undefined;
            }

            if (hideTimer !== undefined) {
                window.clearTimeout(hideTimer);
                hideTimer = undefined;
            }
        };

        const getPreviewContent = (target: HTMLElement) => {
            const clone = target.cloneNode(true) as HTMLElement;

            clone.removeAttribute('id');

            /*
             * Do not duplicate nested relic / Light Cone popover
             * cards inside the note preview. Keep only their labels.
             */
            clone
                .querySelectorAll('.info-popover-card, [popover]')
                .forEach((element) => element.remove());

            clone.querySelectorAll('button, a').forEach((element) => {
                const replacement = document.createElement('span');

                replacement.innerHTML = element.innerHTML;

                if (element.classList.contains('info-popover-trigger')) {
                    replacement.className = 'note-preview-inline-name';
                }

                element.replaceWith(replacement);
            });

            clone
                .querySelectorAll('[id]')
                .forEach((element) => element.removeAttribute('id'));

            return clone.innerHTML;
        };

        const positionPopup = () => {
            if (!popup || !activeTrigger || popup.hidden) {
                return;
            }

            const triggerRect = activeTrigger.getBoundingClientRect();

            const popupRect = popup.getBoundingClientRect();

            const gap = 10;
            const edge = 12;

            let left =
                triggerRect.left + triggerRect.width / 2 - popupRect.width / 2;

            left = Math.max(
                edge,
                Math.min(left, window.innerWidth - popupRect.width - edge),
            );

            const fitsBelow =
                window.innerHeight - triggerRect.bottom >=
                popupRect.height + gap + edge;

            let top = fitsBelow
                ? triggerRect.bottom + gap
                : triggerRect.top - popupRect.height - gap;

            top = Math.max(
                edge,
                Math.min(top, window.innerHeight - popupRect.height - edge),
            );

            popup.style.left = `${left}px`;
            popup.style.top = `${top}px`;
        };

        const showPreview = (trigger: HTMLElement) => {
            if (!popup) {
                return;
            }

            const noteId = trigger.dataset.notePreviewId;

            if (!noteId) {
                return;
            }

            const target = document.getElementById(noteId);

            if (!target) {
                return;
            }

            clearTimers();

            showTimer = window.setTimeout(() => {
                activeTrigger = trigger;

                popup.innerHTML = getPreviewContent(target);

                popup.hidden = false;
                popup.dataset.open = 'true';

                trigger.setAttribute('aria-describedby', 'note-preview-popup');

                requestAnimationFrame(positionPopup);
            }, 90);
        };

        const hidePreview = (trigger?: HTMLElement) => {
            if (!popup) {
                return;
            }

            clearTimers();

            hideTimer = window.setTimeout(() => {
                if (trigger && activeTrigger !== trigger) {
                    return;
                }

                activeTrigger?.removeAttribute('aria-describedby');

                activeTrigger = null;
                popup.dataset.open = 'false';
                popup.hidden = true;
                popup.innerHTML = '';
            }, 80);
        };

        document.addEventListener('pointerover', (event) => {
            const trigger = (event.target as HTMLElement)?.closest<HTMLElement>(
                '.note-link[data-note-preview-id]',
            );

            if (!trigger) {
                return;
            }

            showPreview(trigger);
        });

        document.addEventListener('pointerout', (event) => {
            const trigger = (event.target as HTMLElement)?.closest<HTMLElement>(
                '.note-link[data-note-preview-id]',
            );

            if (!trigger) {
                return;
            }

            const related = event.relatedTarget as Node | null;

            if (related && trigger.contains(related)) {
                return;
            }

            hidePreview(trigger);
        });

        document.addEventListener('focusin', (event) => {
            const trigger = (event.target as HTMLElement)?.closest<HTMLElement>(
                '.note-link[data-note-preview-id]',
            );

            if (trigger) {
                showPreview(trigger);
            }
        });

        document.addEventListener('focusout', (event) => {
            const trigger = (event.target as HTMLElement)?.closest<HTMLElement>(
                '.note-link[data-note-preview-id]',
            );

            if (trigger) {
                hidePreview(trigger);
            }
        });

        /*
         * Keep the existing click-to-scroll behavior.
         * The preview is supplemental only.
         */
        window.addEventListener('scroll', () => hidePreview(), true);

        window.addEventListener('resize', () => hidePreview());

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                hidePreview();
            }
        });
    }
</script>

<style is:global>
    .note-preview-popup {
        position: fixed;
        z-index: 12000;

        width: min(360px, calc(100vw - 24px));
        max-height: min(320px, calc(100vh - 24px));
        overflow: auto;

        border: 1px solid
            color-mix(in srgb, var(--element) 42%, rgba(255, 255, 255, 0.16));
        border-radius: 8px;
        padding: 9px 10px;

        background-color: #1b1f26;

        background-image: linear-gradient(
            180deg,
            color-mix(in srgb, var(--element) 10%, transparent),
            transparent 55%
        );

        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.32);

        color: var(--text);
        font-size: 0.78rem;
        font-weight: 500;
        line-height: 1.4;

        pointer-events: none;
    }

    .note-preview-popup[hidden] {
        display: none;
    }

    .note-preview-popup .element-bold {
        color: color-mix(in srgb, #fff 30%, var(--element) 70%);
        font-weight: 850;
    }

    .note-preview-popup .note-preview-inline-name {
        color: color-mix(in srgb, #fff 82%, var(--accent) 18%);
        font-weight: 750;
    }

    .note-preview-popup p {
        margin: 4px 0;
    }

    .note-preview-popup ul,
    .note-preview-popup ol {
        margin: 5px 0;
        padding-left: 1.25rem;
    }

    .note-preview-popup strong {
        font-weight: 850;
    }

    @media (max-width: 720px) {
        .note-preview-popup {
            width: min(320px, calc(100vw - 20px));
            max-height: min(260px, calc(100vh - 20px));
            font-size: 0.75rem;
        }
    }
</style>
