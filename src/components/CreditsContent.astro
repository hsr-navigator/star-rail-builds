---
import credits from '../content/site/credits.json';
import { t } from '../utils/i18n';

type CreditsData = {
    translators: Record<string, string[]>;
    sections: {
        title: string;
        names: string[];
    }[];
};

const { lang = 'en', locale } = Astro.props as {
    lang?: string;
    locale: any;
};
const termsOfServiceUrls: Record<string, string> = {
    en: 'https://hsr.hoyoverse.com/en-us/company/terms',
    cht: 'https://hsr.hoyoverse.com/zh-tw/company/terms',
    de: 'https://hsr.hoyoverse.com/de-de/company/terms',
    fr: 'https://hsr.hoyoverse.com/fr-fr/company/terms',
    ru: 'https://hsr.hoyoverse.com/ru-ru/company/terms',
    vn: 'https://hsr.hoyoverse.com/vi-vn/company/terms',
};

const termsOfServiceUrl = termsOfServiceUrls[lang] ?? termsOfServiceUrls.en;
const creditsData = credits as CreditsData;
const translators = [
    ...new Set(Object.values(creditsData.translators ?? {}).flat()),
];
---

<section class="card credits-card credits-legal-card">
    <h2>
        {t(locale, 'ui', 'Legal Notice', undefined, false)}
    </h2>

    <p>
        {t(locale, 'ui', 'Legal notice unofficial', undefined, false)}
    </p>

    <p>
        {t(locale, 'ui', 'Legal notice original content', undefined, false)}{
            ' '
        }

        <a
            href="https://github.com/coffinn/star-rail-builds/blob/main/LICENSE.md"
            target="_blank"
            rel="noopener noreferrer"
        >
            {t(locale, 'ui', 'Repository license notice', undefined, false)}
        </a>
        .
    </p>

    <p>
        {t(locale, 'ui', 'Legal notice ownership', undefined, false)}
    </p>

    <p class="credits-legal-declaration">
        {t(locale, 'ui', 'Legal notice rights reserved', undefined, false)}
    </p>

    <p>
        {t(locale, 'ui', 'Legal notice unpublished', undefined, false)}{' '}

        <a href={termsOfServiceUrl} target="_blank" rel="noopener noreferrer">
            {t(locale, 'ui', 'Terms of Service', undefined, false)}
        </a>
        .
    </p>
</section>

<section class="card credits-card">
    <p>
        {t(locale, 'ui', 'Credits feedback')}{' '}
        <button
            class="credits-feedback-button"
            type="button"
            data-feedback-open
        >
            {t(locale, 'ui', 'Feedback', undefined, false)}
        </button>
        .
    </p>
</section>

{
    translators.length > 0 && (
        <section class="card credits-card">
            <h2>{t(locale, 'ui', 'Translator')}</h2>
            <ul class="credits-list">
                {translators.map((name) => (
                    <li>{name}</li>
                ))}
            </ul>
        </section>
    )
}

{
    creditsData.sections.map((section) => (
        <section class="card credits-card">
            <h2>{t(locale, 'ui', section.title)}</h2>
            <ul class="credits-list">
                {section.names.map((name) => (
                    <li>{name}</li>
                ))}
            </ul>
        </section>
    ))
}
