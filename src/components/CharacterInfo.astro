---
import {
    renderCharacterAbilityDescription,
    type CharacterAbility,
    type CharacterAbilityVariant,
    type CharacterData,
} from '../utils/character-data';
import HighlightedText from './HighlightedText.astro';
import { t } from '../utils/i18n';

const { character, locale } = Astro.props as {
    character: CharacterData;
    locale: any;
};

const ui = (id: string) => t(locale, 'ui', id, undefined, false);

/*
 * Prefer the current human-readable UI key, but fall back to the
 * older snake_case key used by some locale files. This keeps labels
 * such as Break (Total) translated while translations are migrated.
 */
const uiWithFallback = (id: string, legacyId: string) => {
    const translated = ui(id);

    if (translated !== id) {
        return translated;
    }

    const legacyTranslation = ui(legacyId);

    return legacyTranslation !== legacyId ? legacyTranslation : translated;
};

/*
 * Break metadata can contain a qualifier in parentheses, for example
 * "20 (Enhanced Counter)". Translate that qualifier through ui.json
 * when a locale provides it.
 */
const translateBreakValue = (value: string | number | undefined) => {
    if (typeof value !== 'string') {
        return value;
    }

    return value.replace(/\(([^()]+)\)/g, (_match, label: string) => {
        const translated = ui(label);
        return `(${translated})`;
    });
};

const levelAbbreviation = ui('Lv.');

const getAbilityTypeLabel = (id: string, fallback: string) => {
    let translationId: string | null = null;

    if (!id.includes(':')) {
        translationId = id;
    } else if (id === 'elation:skill') {
        translationId = 'elation-skill';
    }

    if (!translationId) {
        return fallback;
    }

    const translated = t(locale, 'ability', translationId, undefined, false);

    return translated === translationId ? fallback : translated;
};
type AbilityWithMeta = CharacterAbility | CharacterAbilityVariant;

const getAbilityMetaItems = (ability: AbilityWithMeta) =>
    [
        {
            label: ui('Energy Gain'),
            value: ability.energy_gain,
        },

        {
            label: ui('Energy Cost'),
            value: ability.energy_cost,
        },

        {
            label: ui('Participant ID'),
            value: ability.participant_id,
        },

        /*
         * Simple Break value.
         */
        {
            label: ui('Break'),
            value: translateBreakValue(ability.break),
        },

        /*
         * Detailed Break values.
         *
         * ORDER:
         * Main
         * Adjacent
         * AoE
         * First Hit
         * Bounce
         * Final Hit
         * Total
         */
        {
            label: uiWithFallback('Break (Main)', 'break_main'),
            value: translateBreakValue(ability.break_main),
        },

        {
            label: uiWithFallback('Break (Adjacent)', 'break_adjacent'),
            value: translateBreakValue(ability.break_adjacent),
        },

        {
            label: uiWithFallback('Break (AoE)', 'break_aoe'),
            value: translateBreakValue(ability.break_aoe),
        },

        {
            label: uiWithFallback('Break (First Hit)', 'break_first_hit'),
            value: translateBreakValue(ability.break_first_hit),
        },

        {
            label: uiWithFallback('Break (Per Bounce)', 'break_bounce'),
            value: translateBreakValue(ability.break_bounce),
        },

        {
            label: uiWithFallback('Break (Final Hit)', 'break_final_hit'),
            value: translateBreakValue(ability.break_final_hit),
        },

        {
            label: uiWithFallback('Break (Total)', 'break_total'),
            value: translateBreakValue(ability.break_total),
        },
    ].filter(
        (
            item,
        ): item is {
            label: string;
            value: string | number;
        } =>
            item.value !== undefined &&
            item.value !== null &&
            item.value !== '',
    );
type SelectableAbilityVariant = CharacterAbilityVariant & {
    id?: string;
    selector_label?: string;

    min_level?: number;
    max_level?: number;
    default_level?: number;
};
type SelectableCharacterAbility = CharacterAbility & {
    variant_selector?: {
        label?: string;
    };
    variants?: SelectableAbilityVariant[];
};

const abilityOrder = ['basic', 'skill', 'ultimate', 'talent', 'technique'];

const normalAbilities = abilityOrder
    .map((id) => {
        const ability = character.abilities?.[id];

        if (!ability) {
            return null;
        }

        return {
            id,
            ability,
        };
    })
    .filter(
        (
            item,
        ): item is {
            id: string;
            ability: CharacterAbility;
        } => item !== null,
    );

const memospriteAbilities = Object.entries(
    character.memosprite?.skills ?? {},
).map(([id, ability]) => ({
    id: `memosprite:${id}`,
    ability,
}));

const elationAbilities = Object.entries(character.elation?.skills ?? {}).map(
    ([id, ability]) => ({
        id: `elation:${id}`,
        ability,
    }),
);

const globalPassives = Object.entries(character.global_passives ?? {}).map(
    ([id, passive]) => ({
        id,
        passive,
    }),
);

const abilitySections = [
    {
        id: 'normal',
        title: ui('Abilities'),
        abilities: normalAbilities,
    },

    ...(character.memosprite && memospriteAbilities.length > 0
        ? [
              {
                  id: 'memosprite',
                  title: `${ui('Memosprite')} — ${character.memosprite.name}`,
                  abilities: memospriteAbilities,
              },
          ]
        : []),

    ...(elationAbilities.length > 0
        ? [
              {
                  id: 'elation',
                  title: ui('Elation'),
                  abilities: elationAbilities,
              },
          ]
        : []),
];

const majorTraces = Object.entries(character.major_traces ?? {}).sort(
    ([a], [b]) => Number(a) - Number(b),
);

const eidolons = [...(character.eidolons ?? [])].sort(
    (a, b) => a.level - b.level,
);

type LevelledAbility = {
    min_level?: number;
    max_level?: number;
    default_level?: number;
    scaling?: Record<string, Array<number | string>>;
};

const getScalingLength = (ability?: LevelledAbility) => {
    if (!ability?.scaling) {
        return 0;
    }

    return Math.max(
        0,
        ...Object.values(ability.scaling).map((values) => values.length),
    );
};

/*
 * A grouped ability can be static while one or more variants are scalable
 * (Castorice's grouped Memosprite Talents are the important example).
 * In that case, use the scalable variant's level range for the shared slider.
 */
const getAbilityLevelConfig = (
    ability: LevelledAbility,
    fallback?: LevelledAbility,
) => {
    const minLevel = ability.min_level ?? fallback?.min_level ?? 1;

    const scalingLength =
        getScalingLength(ability) || getScalingLength(fallback);

    const inferredMaxLevel =
        scalingLength > 0 ? minLevel + scalingLength - 1 : minLevel;

    const maxLevel =
        ability.max_level ?? fallback?.max_level ?? inferredMaxLevel;

    const defaultLevel = Math.max(
        minLevel,
        Math.min(
            ability.default_level ?? fallback?.default_level ?? maxLevel,
            maxLevel,
        ),
    );

    const levels = Array.from(
        { length: Math.max(1, maxLevel - minLevel + 1) },
        (_, index) => minLevel + index,
    );

    return {
        minLevel,
        maxLevel,
        defaultLevel,
        levels,
    };
};

const hasAbilityMeta = (ability: CharacterAbility | CharacterAbilityVariant) =>
    ability.energy_gain !== undefined ||
    ability.energy_cost !== undefined ||
    ability.break !== undefined ||
    ability.break_main !== undefined ||
    ability.break_adjacent !== undefined ||
    ability.break_bounce !== undefined ||
    ability.break_aoe !== undefined ||
    ability.break_first_hit !== undefined ||
    ability.break_final_hit !== undefined ||
    ability.break_total !== undefined;
const renderVariantDescription = (
    variant: SelectableAbilityVariant,
    parentAbility: CharacterAbility,
    requestedLevel?: number,
) => {
    if (!variant.description_template || !variant.scaling) {
        return variant.description ?? '';
    }

    const { minLevel, maxLevel, defaultLevel } = getAbilityLevelConfig(
        variant as SelectableAbilityVariant,
        parentAbility,
    );

    const level = Math.max(
        minLevel,
        Math.min(requestedLevel ?? defaultLevel, maxLevel),
    );

    const index = level - minLevel;

    return variant.description_template.replace(
        /\{\{([a-zA-Z0-9_-]+)\}\}/g,
        (match, key: string) => {
            const value = variant.scaling?.[key]?.[index];

            return value === undefined ? match : String(value);
        },
    );
};
---

<details class="card character-info-card section-collapse" open>
    <summary class="section-collapse-summary">
        <h2>{ui('Character Info')}</h2>

        <span class="section-collapse-chevron" aria-hidden="true"></span>
    </summary>

    <div class="section-collapse-body">
        <!-- ========================= -->
        <!-- Level 80 Stats            -->
        <!-- ========================= -->

        {
            character.level_80_stats && (
                <section class="character-info-section">
                    <h3>{ui('Level 80 Stats')}</h3>

                    <div class="character-stat-grid">
                        {character.level_80_stats.hp !== undefined && (
                            <span>
                                {ui('HP')}
                                <strong>{character.level_80_stats.hp}</strong>
                            </span>
                        )}

                        {character.level_80_stats.atk !== undefined && (
                            <span>
                                {ui('ATK')}
                                <strong>{character.level_80_stats.atk}</strong>
                            </span>
                        )}

                        {character.level_80_stats.def !== undefined && (
                            <span>
                                {ui('DEF')}
                                <strong>{character.level_80_stats.def}</strong>
                            </span>
                        )}

                        {character.level_80_stats.spd !== undefined && (
                            <span>
                                {ui('SPD')}
                                <strong>{character.level_80_stats.spd}</strong>
                            </span>
                        )}

                        {character.max_energy != null && (
                            <span>
                                {ui('Energy')}
                                <strong>{character.max_energy}</strong>
                            </span>
                        )}
                    </div>
                </section>
            )
        }

        <!-- ========================= -->
        <!-- Abilities                 -->
        <!-- ========================= -->

        {
            abilitySections.map((section) => (
                <section class="character-info-section">
                    <h3>{section.title}</h3>

                    {section.id === 'memosprite' && character.memosprite && (
                        <div class="character-detail-meta character-mechanic-meta">
                            {character.memosprite.initial_spd !== undefined && (
                                <span>
                                    {ui('Initial SPD')}:{' '}
                                    <strong>
                                        {character.memosprite.initial_spd}
                                    </strong>
                                </span>
                            )}

                            {character.memosprite.hp_source && (
                                <span>
                                    {ui('Max HP')}:{' '}
                                    <strong>
                                        {character.memosprite.hp_source}
                                    </strong>
                                </span>
                            )}
                        </div>
                    )}

                    <div class="character-info-details character-ability-grid">
                        {section.abilities.map(({ id, ability }) => {
                            const metaItems = getAbilityMetaItems(ability);
                            const hasMeta = hasAbilityMeta(ability);
                            const selectableAbility =
                                ability as SelectableCharacterAbility;

                            const variants = selectableAbility.variants ?? [];

                            /*
                             * The parent ability normally owns the trace level.
                             * Some grouped abilities are static parents with a
                             * scalable variant instead. Castorice's Memosprite
                             * Talent is the important example:
                             *
                             * - Mooncocoon Shrouds the Form: static parent
                             * - Roar Rumbles the Realm: static variant
                             * - Wings Sweep the Ruins: Lv. 1-7 scalable variant
                             *
                             * In that case, let the scalable variant provide the
                             * shared slider's min/max/default level.
                             */
                            const abilityScalable = Boolean(
                                ability.description_template && ability.scaling,
                            );

                            const firstScalableVariant = variants.find(
                                (variant) =>
                                    Boolean(
                                        variant.description_template &&
                                        variant.scaling,
                                    ),
                            );

                            const levelSource = abilityScalable
                                ? undefined
                                : firstScalableVariant;

                            const { minLevel, maxLevel, defaultLevel, levels } =
                                getAbilityLevelConfig(ability, levelSource);

                            const hasScalableVariant =
                                firstScalableVariant !== undefined;

                            const scalable =
                                (abilityScalable || hasScalableVariant) &&
                                maxLevel > minLevel;

                            const variantSelector =
                                selectableAbility.variant_selector;

                            return (
                                <details
                                    open
                                    data-character-ability={id}
                                    data-level-prefix={levelAbbreviation}
                                    data-static-detail
                                >
                                    <summary>
                                        <strong>
                                            {getAbilityTypeLabel(
                                                id,
                                                ability.type,
                                            )}
                                        </strong>

                                        <span class="character-ability-name">
                                            {ability.name}
                                        </span>

                                        {scalable && (
                                            <span
                                                class="character-ability-level"
                                                data-character-level-value
                                            >
                                                {levelAbbreviation}{' '}
                                                {defaultLevel}
                                            </span>
                                        )}
                                    </summary>

                                    <div class="character-detail-body">
                                        {ability.tag && (
                                            <p class="character-ability-tag">
                                                <strong>{ui('Type')}:</strong>{' '}
                                                {ability.tag}
                                            </p>
                                        )}

                                        {metaItems.length > 0 && (
                                            <div class="character-detail-meta">
                                                {metaItems.map((item) => (
                                                    <span>
                                                        {item.label}:{' '}
                                                        <strong>
                                                            {item.value}
                                                        </strong>
                                                    </span>
                                                ))}
                                            </div>
                                        )}

                                        {scalable && (
                                            <div class="character-trace-slider">
                                                <div class="character-slider-header">
                                                    <strong>
                                                        {ui('Trace Level')}
                                                    </strong>

                                                    <span
                                                        data-character-level-value
                                                    >
                                                        {levelAbbreviation}{' '}
                                                        {defaultLevel}
                                                    </span>
                                                </div>

                                                <input
                                                    type="range"
                                                    min={minLevel}
                                                    max={maxLevel}
                                                    step="1"
                                                    value={defaultLevel}
                                                    data-character-level-slider
                                                    aria-label={`${ability.name} ${ui('Trace Level')}`}
                                                />

                                                <div class="character-slider-bounds">
                                                    <span>
                                                        {levelAbbreviation}{' '}
                                                        {minLevel}
                                                    </span>

                                                    <span>
                                                        {levelAbbreviation}{' '}
                                                        {maxLevel}
                                                    </span>
                                                </div>
                                            </div>
                                        )}

                                        <div class="character-ability-description">
                                            {abilityScalable &&
                                            maxLevel > minLevel ? (
                                                levels.map((level) => (
                                                    <p
                                                        data-character-level-panel={
                                                            level
                                                        }
                                                        hidden={
                                                            level !==
                                                            defaultLevel
                                                        }
                                                    >
                                                        <HighlightedText
                                                            text={renderCharacterAbilityDescription(
                                                                ability,
                                                                level,
                                                                minLevel,
                                                                defaultLevel,
                                                            )}
                                                        />
                                                    </p>
                                                ))
                                            ) : (
                                                <p>
                                                    <HighlightedText
                                                        text={renderCharacterAbilityDescription(
                                                            ability,
                                                            undefined,
                                                            minLevel,
                                                            defaultLevel,
                                                        )}
                                                    />
                                                </p>
                                            )}
                                        </div>

                                        {variants.length > 0 && (
                                            <div
                                                class="character-ability-variants"
                                                data-ability-variants
                                            >
                                                {variantSelector && (
                                                    <label class="character-variant-selector">
                                                        <span>
                                                            {variantSelector.label ??
                                                                ui('Select')}
                                                        </span>

                                                        <select
                                                            data-variant-select
                                                            aria-label={
                                                                variantSelector.label ??
                                                                ui(
                                                                    'Select alternate ability',
                                                                )
                                                            }
                                                        >
                                                            {variants.map(
                                                                (
                                                                    variant,
                                                                    index,
                                                                ) => (
                                                                    <option
                                                                        value={
                                                                            variant.id ??
                                                                            String(
                                                                                index,
                                                                            )
                                                                        }
                                                                    >
                                                                        {variant.selector_label ??
                                                                            variant.name}
                                                                    </option>
                                                                ),
                                                            )}
                                                        </select>
                                                    </label>
                                                )}

                                                {variants.map(
                                                    (variant, index) => {
                                                        const variantMetaItems =
                                                            getAbilityMetaItems(
                                                                variant,
                                                            );
                                                        const variantLevelConfig =
                                                            getAbilityLevelConfig(
                                                                variant,
                                                                ability,
                                                            );

                                                        const variantScalable =
                                                            Boolean(
                                                                variant.description_template &&
                                                                variant.scaling,
                                                            ) &&
                                                            variantLevelConfig.maxLevel >
                                                                variantLevelConfig.minLevel;

                                                        const variantId =
                                                            variant.id ??
                                                            String(index);
                                                        const variantHasMeta =
                                                            hasAbilityMeta(
                                                                variant,
                                                            );
                                                        return (
                                                            <section
                                                                class="character-ability-variant"
                                                                data-ability-variant
                                                                data-variant-id={
                                                                    variantId
                                                                }
                                                                hidden={
                                                                    variantSelector
                                                                        ? index !==
                                                                          0
                                                                        : false
                                                                }
                                                            >
                                                                <div class="character-ability-variant-header">
                                                                    <strong>
                                                                        {
                                                                            variant.type
                                                                        }
                                                                    </strong>

                                                                    <span class="character-ability-name">
                                                                        {
                                                                            variant.name
                                                                        }
                                                                    </span>
                                                                </div>

                                                                {variant.tag && (
                                                                    <p class="character-ability-tag">
                                                                        <strong>
                                                                            {ui(
                                                                                'Type',
                                                                            )}
                                                                            :
                                                                        </strong>{' '}
                                                                        {
                                                                            variant.tag
                                                                        }
                                                                    </p>
                                                                )}
                                                                {variantMetaItems.length >
                                                                    0 && (
                                                                    <div class="character-detail-meta">
                                                                        {variantMetaItems.map(
                                                                            (
                                                                                item,
                                                                            ) => (
                                                                                <span>
                                                                                    {
                                                                                        item.label
                                                                                    }

                                                                                    :{' '}
                                                                                    <strong>
                                                                                        {
                                                                                            item.value
                                                                                        }
                                                                                    </strong>
                                                                                </span>
                                                                            ),
                                                                        )}
                                                                    </div>
                                                                )}

                                                                <div class="character-ability-description">
                                                                    {variantScalable ? (
                                                                        levels.map(
                                                                            (
                                                                                level,
                                                                            ) => (
                                                                                <p
                                                                                    data-character-level-panel={
                                                                                        level
                                                                                    }
                                                                                    hidden={
                                                                                        level !==
                                                                                        defaultLevel
                                                                                    }
                                                                                >
                                                                                    <HighlightedText
                                                                                        text={renderVariantDescription(
                                                                                            variant,
                                                                                            ability,
                                                                                            level,
                                                                                        )}
                                                                                    />
                                                                                </p>
                                                                            ),
                                                                        )
                                                                    ) : (
                                                                        <p>
                                                                            <HighlightedText
                                                                                text={renderVariantDescription(
                                                                                    variant,
                                                                                    ability,
                                                                                )}
                                                                            />
                                                                        </p>
                                                                    )}
                                                                </div>
                                                            </section>
                                                        );
                                                    },
                                                )}
                                            </div>
                                        )}
                                    </div>
                                </details>
                            );
                        })}
                    </div>
                </section>
            ))
        }

        {
            globalPassives.length > 0 && (
                <section class="character-info-section">
                    <h3>{ui('Global Passives')}</h3>

                    <div class="character-global-passive-grid">
                        {globalPassives.map(({ id, passive }) => (
                            <article
                                class="character-global-passive-card"
                                data-global-passive={id}
                            >
                                <div class="character-global-passive-header">
                                    <strong class="character-global-passive-type">
                                        {ui('Global')}
                                        <small>{ui('Passive')}</small>
                                    </strong>

                                    <div class="character-global-passive-title">
                                        <span class="character-ability-name">
                                            {passive.name}
                                        </span>

                                        {passive.tag && (
                                            <small>{passive.tag}</small>
                                        )}
                                    </div>
                                </div>

                                <div class="character-global-passive-body">
                                    <p>
                                        <HighlightedText
                                            text={passive.description}
                                        />
                                    </p>
                                </div>
                            </article>
                        ))}
                    </div>
                </section>
            )
        }

        <!-- ========================= -->
        <!-- Major Traces              -->
        <!-- ========================= -->

        <section class="character-info-section">
            <h3>{ui('Major Traces')}</h3>

            <div class="character-info-details character-major-trace-grid">
                {
                    majorTraces.map(([ascension, trace]) => (
                        <details open data-static-detail>
                            <summary>
                                <strong class="character-major-trace-label">
                                    {ascension && <span>A{ascension}</span>}

                                    <small>{ui('Major Trace')}</small>
                                </strong>
                                <span>{trace.name}</span>
                            </summary>

                            <div class="character-detail-body">
                                <p>
                                    <HighlightedText text={trace.description} />
                                </p>
                            </div>
                        </details>
                    ))
                }
            </div>
        </section>

        <!-- ========================= -->
        <!-- Stat Bonuses              -->
        <!-- ========================= -->

        <section class="character-info-section">
            <h3>{ui('Stat Bonuses')}</h3>

            <div class="character-stat-grid">
                {
                    character.stat_bonuses.map((bonus) => (
                        <span>
                            {bonus.stat}

                            <strong>{bonus.value}</strong>
                        </span>
                    ))
                }
            </div>
        </section>

        <!-- ========================= -->
        <!-- Eidolons                  -->
        <!-- ========================= -->

        <section class="character-info-section">
            <h3>{ui('Eidolons')}</h3>

            <div class="character-info-details character-eidolon-grid">
                {
                    eidolons.map((eidolon) => (
                        <details open data-static-detail>
                            <summary>
                                <strong>E{eidolon.level}</strong>

                                <span>{eidolon.name}</span>
                            </summary>

                            <div class="character-detail-body">
                                <p>
                                    <HighlightedText
                                        text={eidolon.description}
                                    />
                                </p>
                            </div>
                        </details>
                    ))
                }
            </div>
        </section>
    </div>
</details>

<script>
    document
        .querySelectorAll<HTMLDetailsElement>('details[data-static-detail]')
        .forEach((detail) => {
            const summary = detail.querySelector('summary');

            if (!summary) {
                return;
            }

            summary.addEventListener('click', (event) => {
                event.preventDefault();
            });
        });
    document
        .querySelectorAll<HTMLElement>('[data-character-ability]')
        .forEach((ability) => {
            const slider = ability.querySelector<HTMLInputElement>(
                '[data-character-level-slider]',
            );

            if (!slider) {
                return;
            }

            const levelPrefix = ability.dataset.levelPrefix ?? 'Lv.';

            const levelLabels = ability.querySelectorAll<HTMLElement>(
                '[data-character-level-value]',
            );

            const panels = ability.querySelectorAll<HTMLElement>(
                '[data-character-level-panel]',
            );

            const updateLevel = () => {
                const level = slider.value;

                levelLabels.forEach((label) => {
                    label.textContent = `${levelPrefix} ${level}`;
                });

                panels.forEach((panel) => {
                    panel.hidden = panel.dataset.characterLevelPanel !== level;
                });
            };

            slider.addEventListener('input', updateLevel);
        });

    document
        .querySelectorAll<HTMLElement>('[data-ability-variants]')
        .forEach((container) => {
            const select = container.querySelector<HTMLSelectElement>(
                '[data-variant-select]',
            );

            if (!select) {
                return;
            }

            const variantPanels = Array.from(
                container.querySelectorAll<HTMLElement>(
                    '[data-ability-variant]',
                ),
            );

            const updateVariant = () => {
                variantPanels.forEach((panel) => {
                    panel.hidden = panel.dataset.variantId !== select.value;
                });
            };

