---
import { t } from '../utils/i18n';

const { buildNote, locale } = Astro.props;

type CalculationTag =
    'character-calculations' | 'investment-chart' | 'team-guide';

type CalculationCredit = {
    label?: string;
    tag?: CalculationTag;
    author?: string;
    link?: string;
    detail?: string;
};

const validTags: CalculationTag[] = [
    'character-calculations',
    'investment-chart',
    'team-guide',
];

const getTagLabel = (tag: CalculationTag) => {
    switch (tag) {
        case 'character-calculations':
            return t(locale, 'ui', 'Character Calculations', undefined, false);

        case 'investment-chart':
            return t(locale, 'ui', 'Investment Chart', undefined, false);

        case 'team-guide':
            return t(locale, 'ui', 'Team Guide', undefined, false);
    }
};

const rawCredits: CalculationCredit[] = Array.isArray(buildNote?.global)
    ? buildNote.global
    : buildNote?.global
      ? [buildNote.global]
      : [];

const calculationCredits = rawCredits.filter(
    (
        credit,
    ): credit is CalculationCredit & {
        tag: CalculationTag;
        author: string;
        link: string;
    } =>
        Boolean(
            credit?.tag &&
            validTags.includes(credit.tag) &&
            credit.author &&
            credit.link,
        ),
);

/*
 * If all links are the same type, use that
 * type as the card title.
 *
 * If multiple resource types are present,
 * use the generic "Resources" heading.
 */
const uniqueTags = [...new Set(calculationCredits.map((credit) => credit.tag))];

const sectionTitle =
    uniqueTags.length === 1
        ? getTagLabel(uniqueTags[0])
        : t(locale, 'ui', 'Resources', undefined, false);
---

{
    calculationCredits.length > 0 && (
        <section class="build-calculation-card">
            <h2>{sectionTitle}</h2>

            <div class="build-calculation-list">
                {calculationCredits.map((credit) => (
                    <div class="build-calculation-link">
                        <a href={credit.link} target="_blank" rel="noreferrer">
                            {credit.label || getTagLabel(credit.tag)}
                        </a>

                        <div class="build-calculation-credit">
                            {credit.detail && (
                                <>
                                    <span set:html={credit.detail} />

                                    <span aria-hidden="true"> - </span>
                                </>
                            )}
                            {t(locale, 'ui', 'Thank you to')} {credit.author}!
                        </div>
                    </div>
                ))}
            </div>
        </section>
    )
}
