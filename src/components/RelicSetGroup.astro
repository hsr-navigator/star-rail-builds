---
import { t } from '../utils/i18n';
import RelicSetInfoPopover from './RelicSetInfoPopover.astro';
import InlineNoteLabel from './InlineNoteLabel.astro';

type LocalizedRelicEffect = {
    en?: string;
    [lang: string]: string | undefined;
};

type RelicSetInfo = {
    rarity: number;
    '1p'?: LocalizedRelicEffect;
    '2p'?: LocalizedRelicEffect;
    '4p'?: LocalizedRelicEffect;
};

type AggregateRelicSet = {
    id: string;
    name: string;
    info: RelicSetInfo;
};

type RelicSetItem = {
    name: string;
    pieces: number;
    note?: string;
    noteId?: string;
    id?: string;
    info?: RelicSetInfo;

    /*
     * Present only on aggregate / pseudo-set entries such as
     * "2-Pc SPD".
     */
    aggregateSets?: AggregateRelicSet[];
};

type RelicSetGroup = {
    items?: RelicSetItem[];
    choose?: boolean;
    choices?: RelicChoicePool[];
};

type RelicChoicePool = {
    items: RelicSetItem[];
};

type RelicSetRow = {
    items?: RelicSetItem[];
    choicePools?: RelicChoicePool[];
    alt?: boolean;
    bold?: boolean;
    label?: string;
    prefix?: string;
    chooseOne?: boolean;
};

const {
    group,
    locale,
    lang = 'en',
} = Astro.props as {
    group: RelicSetGroup;
    locale: any;
    lang?: string;
};

const groupItems = group.items ?? [];

const rows: RelicSetRow[] = group.choose
    ? [
          ...groupItems.map((item, index) => ({
              items: [item],
              alt: index > 0,
          })),
          {
              alt: true,
              bold: true,
              label: t(locale, 'ui', 'Choose Two'),
          },
      ]
    : group.choices && groupItems.length > 0
      ? [
            {
                items: groupItems,
                choicePools: group.choices,
            },
        ]
      : group.choices
        ? group.choices.map((choice, index) => ({
              items: choice.items,
              alt: index > 0,
              prefix:
                  index > 0
                      ? `${t(locale, 'ui', 'and', undefined, false)} `
                      : '',
              chooseOne: true,
          }))
        : [
              {
                  items: groupItems,
              },
          ];

const hasNoteMarker = (item: RelicSetItem) => item.noteId || item.note;

const isAggregateItem = (item: RelicSetItem) =>
    (item.aggregateSets?.length ?? 0) > 0;
---

{
    /*
     * Choose-two groups render extra items as `.alt`
     * rows to match approximate ties.
     */
}

{
    rows.map((row) => {
        const content = row.label ? (
            <span class="accent-text bold">{row.label}</span>
        ) : (
            <>
                {row.prefix && <span class="accent-text">{row.prefix}</span>}

                {row.items?.map((item, itemIndex) => (
                    <>
                        {itemIndex > 0 && ' / '}

                        <span class="inline-info-label artifact-info-label">
                            <RelicSetInfoPopover
                                relic={item}
                                locale={locale}
                                lang={lang}
                            />

                            {hasNoteMarker(item) && (
                                <InlineNoteLabel
                                    label=""
                                    noteId={item.noteId}
                                    hasNote={Boolean(hasNoteMarker(item))}
                                />
                            )}

                            {!isAggregateItem(item) && (
                                <span class="artifact-piece-suffix">
                                    {'\u00a0'}({item.pieces})
                                </span>
                            )}
                        </span>
                    </>
                ))}

                {row.choicePools?.map((choice) => (
                    <>
                        {' '}
                        <span class="accent-text">
                            {t(locale, 'ui', 'and', undefined, false)}
                        </span>{' '}
                        {choice.items.map((item, itemIndex) => (
                            <>
                                {itemIndex > 0 && ' / '}

                                <span class="inline-info-label artifact-info-label">
                                    <RelicSetInfoPopover
                                        relic={item}
                                        locale={locale}
                                        lang={lang}
                                    />

                                    {hasNoteMarker(item) && (
                                        <InlineNoteLabel
                                            label=""
                                            noteId={item.noteId}
                                            hasNote={Boolean(
                                                hasNoteMarker(item),
                                            )}
                                        />
                                    )}

                                    {!isAggregateItem(item) && (
                                        <span class="artifact-piece-suffix">
                                            {'\u00a0'}({item.pieces})
                                        </span>
                                    )}
                                </span>
                            </>
                        ))}
                        {choice.items.length > 0 && (
                            <>
                                {' '}
                                <span class="accent-text bold">
                                    {t(locale, 'ui', 'Choose One')}
                                </span>
                            </>
                        )}
                    </>
                ))}

                {row.chooseOne && (row.items?.length ?? 0) > 0 && (
                    <>
                        {' '}
                        <span class="accent-text bold">
                            {t(locale, 'ui', 'Choose One')}
                        </span>
                    </>
                )}
            </>
        );

        return row.alt ? (
            <div class={row.bold ? 'alt bold' : 'alt'}>{content}</div>
        ) : (
            <>{content}</>
        );
    })
}
