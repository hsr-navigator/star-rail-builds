---
import { Image } from 'astro:assets';
import physicalIcon from '../assets/filter-icons/types/physical.png';
import fireIcon from '../assets/filter-icons/types/fire.png';
import iceIcon from '../assets/filter-icons/types/ice.png';
import lightningIcon from '../assets/filter-icons/types/lightning.png';
import windIcon from '../assets/filter-icons/types/wind.png';
import quantumIcon from '../assets/filter-icons/types/quantum.png';
import imaginaryIcon from '../assets/filter-icons/types/imaginary.png';

import destructionIcon from '../assets/filter-icons/paths/destruction.png';
import huntIcon from '../assets/filter-icons/paths/hunt.png';
import eruditionIcon from '../assets/filter-icons/paths/erudition.png';
import harmonyIcon from '../assets/filter-icons/paths/harmony.png';
import nihilityIcon from '../assets/filter-icons/paths/nihility.png';
import preservationIcon from '../assets/filter-icons/paths/preservation.png';
import abundanceIcon from '../assets/filter-icons/paths/abundance.png';
import remembranceIcon from '../assets/filter-icons/paths/remembrance.png';
import elationIcon from '../assets/filter-icons/paths/elation.png';
import '../styles/base.css';
import '../styles/build.css';
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalculationLinks from '../components/CalculationLinks.astro';
import { t } from '../utils/i18n';
import { sitePath } from '../utils/paths';

const {
    character,
    characterSlug,
    metadata,
    type,
    lang,
    locale,
    builds = [],
    defaultBuildSlug,
} = Astro.props;
const characterArtAlt = t(locale, 'ui', 'Character art alt').replace(
    '{name}',
    character,
);
const characterHeaderImage = metadata?.portrait ?? metadata?.image;
const typeIcons = {
    physical: physicalIcon,
    fire: fireIcon,
    ice: iceIcon,
    lightning: lightningIcon,
    wind: windIcon,
    quantum: quantumIcon,
    imaginary: imaginaryIcon,
} as const;

const pathIcons = {
    destruction: destructionIcon,
    hunt: huntIcon,
    erudition: eruditionIcon,
    harmony: harmonyIcon,
    nihility: nihilityIcon,
    preservation: preservationIcon,
    abundance: abundanceIcon,
    remembrance: remembranceIcon,
    elation: elationIcon,
} as const;

const typeName = type as keyof typeof typeIcons | undefined;
const pathName = metadata?.path as keyof typeof pathIcons | undefined;

const typeIcon = typeName ? typeIcons[typeName] : undefined;

const pathIcon = pathName ? pathIcons[pathName] : undefined;

const typeLabel = typeName ? t(locale, 'type', typeName) : '';

const pathLabel = pathName ? t(locale, 'path', pathName) : '';

const rarity = Number(metadata?.rarity ?? 0);
const rarityStars = rarity > 0 ? '★'.repeat(rarity) : '';
const buildLabel = t(locale, 'ui', 'Builds', undefined, false);
const bestRoleLabel = t(locale, 'ui', 'Best Role');
---

<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="google-site-verification" content="gMtPbmeLs7Y1hkXMUDHOxfxkkm9MAoQzT-CCgR2cZsk" />
        <title>Star Rail Builds - {character}</title>
        <link rel="icon" type="image/webp" href={sitePath('favicon.png')} />
    </head>

    <body data-type={type}>
        <!-- The header needs the URL slug, not the localized display name. -->
        <Header locale={locale} lang={lang} character={characterSlug} />

        <div class="page character-page">
            <div class="character-page-layout">
                <!-- LEFT SIDEBAR -->
                <aside
                    class="character-header"
                    aria-labelledby="character-title"
                >
                    {
                        characterHeaderImage && (
                            <div class="character-art-stage">
                                <Image
                                    class="character-image"
                                    src={characterHeaderImage}
                                    alt={characterArtAlt}
                                    loading="eager"
                                    decoding="async"
                                    fetchpriority="high"
                                    width={132}
                                    height={132}
                                    densities={[1, 2]}
                                />
                            </div>
                        )
                    }

                    <div class="character-header-copy">
                        <div class="character-title-row">
                            <h1
                                id="character-title"
                                class="page-title"
                                data-pagefind-body
                            >
                                {character}
                            </h1>
                        </div>

                        {
                            (rarityStars || pathLabel) && (
                                <div class="character-identity-meta">
                                    {rarityStars && (
                                        <span class="character-rarity-stars">
                                            {rarityStars}
                                        </span>
                                    )}

                                    {rarityStars && pathLabel && (
                                        <span
                                            class="character-identity-separator"
                                            aria-hidden="true"
                                        />
                                    )}
                                    {typeIcon && (
                                        <img
                                            class="character-title-type-icon"
                                            src={typeIcon.src}
                                            alt=""
                                            title={typeLabel}
                                            width="30"
                                            height="30"
                                            aria-hidden="true"
                                        />
                                    )}
                                    {pathIcon && (
                                        <img
                                            class="character-path-icon"
                                            src={pathIcon.src}
                                            alt=""
                                            width="22"
                                            height="22"
                                            aria-hidden="true"
                                        />
                                    )}

                                    {pathLabel && (
                                        <span class="character-path-name">
                                            {pathLabel}
                                        </span>
                                    )}
                                </div>
                            )
                        }

                        <div class="character-header-meta">
                            {
                                metadata?.last_updated && (
                                    <div class="last-updated">
                                        <span>
                                            {t(locale, 'ui', 'Last Updated')}
                                        </span>

                                        <strong>
                                            {t(locale, 'ui', 'Version')}{' '}
                                            {metadata.last_updated}
                                        </strong>
                                    </div>
                                )
                            }
                        </div>
                    </div>

                    {
                        builds.length > 0 && (
                            <nav class="build-switcher" aria-label={buildLabel}>
                                {builds.map((build: any, index: number) => {
                                    const isDefaultBuild =
                                        build.slug === defaultBuildSlug ||
                                        (!defaultBuildSlug && index === 0);

                                    return (
                                        <button
                                            id={`build-tab-${build.slug}`}
                                            class={`build-switcher-button${
                                                isDefaultBuild
                                                    ? ' is-active'
                                                    : ''
                                            }`}
                                            type="button"
                                            data-build-tab
                                            data-id={build.slug}
                                            aria-controls={`build-content-${build.slug}`}
                                            aria-pressed={
                                                isDefaultBuild
                                                    ? 'true'
                                                    : 'false'
                                            }
                                        >
                                            <span class="build-switcher-name">
                                                {build.name}
                                            </span>

                                            {build.isBest && (
                                                <span class="build-badge">
                                                    {bestRoleLabel}
                                                </span>
                                            )}
                                        </button>
                                    );
                                })}
                            </nav>
                        )
                    }

                    {
                        builds.length > 0 && (
                            <div class="build-calculation-panels">
                                {builds
                                    .filter(
                                        (build: any) => build.hasCalculations,
                                    )
                                    .map((build: any) => {
                                        const isDefaultBuild =
                                            build.slug === defaultBuildSlug;

                                        return (
                                            <div
                                                class={`build-calculation-panel${
                                                    isDefaultBuild
                                                        ? ' is-active'
                                                        : ''
                                                }`}
                                                data-build-calculation-panel
                                                data-id={build.slug}
                                                hidden={!isDefaultBuild}
                                                aria-hidden={
                                                    isDefaultBuild
                                                        ? 'false'
                                                        : 'true'
                                                }
                                            >
                                                <CalculationLinks
                                                    buildNote={build.buildNote}
                                                    locale={locale}
                                                />
                                            </div>
                                        );
                                    })}
                            </div>
                        )
                    }
                </aside>

                <!-- MAIN CHARACTER BUILD CONTENT -->
                <div class="character-main">
                    <slot />
                </div>
            </div>
        </div>

        <Footer lang={lang} />
    </body>
</html>
