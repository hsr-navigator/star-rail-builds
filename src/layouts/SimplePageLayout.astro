---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/theme.css';
import { sitePath } from '../utils/paths';

const { title, lang = 'en', locale, page, showTitle = true } = Astro.props;
---

<html lang={lang}>
    <head>
        <script is:inline>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    'gtm.start': new Date().getTime(),
                    event: 'gtm.js',
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-TDZGPJ3W');
        </script>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href={sitePath('favicon.png')} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="google-site-verification"
            content="gMtPbmeLs7Y1hkXMUDHOxfxkkm9MAoQzT-CCgR2cZsk"
        />
        <title>{title} - Star Rail Builds</title>
    </head>
    <body data-type="base">
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-TDZGPJ3W"
                height="0"
                width="0"
                style="display:none;visibility:hidden"
                title="Google Tag Manager"></iframe>
        </noscript>
        <!-- Simple pages share the same localized header/footer shell. -->
        <Header locale={locale} lang={lang} page={page} />
        <main
            class:list={[
                'simple-page',
                (page === 'faq' || page === 'changelog') && 'simple-page-wide',
            ]}
        >
            {showTitle && <h1>{title}</h1>}
            <slot />
        </main>
        <Footer lang={lang} />
    </body>
</html>
