---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NotFoundContent from '../components/NotFoundContent.astro';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/theme.css';
import { getLocale, t } from '../utils/i18n';
import { sitePath } from '../utils/paths';

const locale = getLocale('en');
---

<html lang="en">
    <head>
        <script is:inline>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    'gtm.start': new Date().getTime(),
                    event: 'gtm.js',
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-TDZGPJ3W');
        </script>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href={sitePath('favicon.png')} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{t(locale, 'ui', 'Page Not Found')} - Star Rail Builds</title>
    </head>
    <body data-type="base">
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-TDZGPJ3W"
                height="0"
                width="0"
                style="display:none;visibility:hidden"
                title="Google Tag Manager"></iframe>
        </noscript>
        <Header locale={locale} lang="en" page="404" />
        <NotFoundContent locale={locale} lang="en" detectLanguage />
        <Footer lang="en" />
    </body>
</html>
