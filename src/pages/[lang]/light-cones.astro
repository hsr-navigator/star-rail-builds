---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LightConeBrowser from '../../components/LightConeBrowser.astro';

import '../../styles/base.css';
import '../../styles/home.css';
import '../../styles/theme.css';
import '../../styles/weapons.css';

import { t } from '../../utils/i18n';
import { sitePath } from '../../utils/paths';
import { getLanguageStaticPaths } from '../../utils/routes';
import { getLightConeBrowserData } from '../../utils/light-cone-browser';

export const getStaticPaths = getLanguageStaticPaths;

const lang = Array.isArray(Astro.params.lang)
    ? Astro.params.lang[0]
    : Astro.params.lang;

const data = getLightConeBrowserData(lang ?? 'en');

const { locale } = data;

const title = t(locale, 'ui', 'Light Cones', undefined, false) || 'Light Cones';
---

<html lang={data.lang}>
    <head>
        <meta charset="utf-8" />

        <link rel="icon" type="image/webp" href={sitePath('favicon.png')} />

        <meta name="viewport" content="width=device-width" />

        <meta name="generator" content={Astro.generator} />

        <title>{title} - Star Rail Builds</title>
    </head>

    <body
        data-type="base"
        class="browser-background"
        style={`--browser-background-image: url("${sitePath('browser-bg.png')}")`}
    >
        <Header locale={locale} lang={data.lang} page="light-cones" />

        <main class="weapon-page">
            <h1>{title}</h1>

            <LightConeBrowser data={data} locale={locale} />
        </main>

        <Footer lang={data.lang} />
    </body>
</html>
