---
import LightCone from '../../components/LightCone.astro';
import Relic from '../../components/Relic.astro';
import RelicStats from '../../components/RelicStats.astro';
import CharacterInfo from '../../components/CharacterInfo.astro';
import Trace from '../../components/Trace.astro';
import Notes from '../../components/Notes.astro';
import RecommendedStats from '../../components/RecommendedStats.astro';

import CharacterPageLayout from '../../layouts/CharacterLayout.astro';

import { getCharacterPageData } from '../../utils/character-page';
import { t } from '../../utils/i18n';
import { getCharacterStaticPaths } from '../../utils/routes';

export const getStaticPaths = getCharacterStaticPaths;

const { lang, character: characterPath } = Astro.params;

const {
    characterSlug,
    characterName,
    characterData,
    metadata,
    type,
    lang: currentLang,
    locale,
    builds,
    warnings,
} = getCharacterPageData({
    lang,
    characterPath,
});

const defaultBuildSlug =
    builds.find((build) => build.isBest)?.slug ?? builds[0]?.slug;

const calculationKeys = [
    'relic',
    'relics',
    'light_cones',
    'global',
    'trace',
    'traces',
];

const hasBuildCalculations = (buildNote: any) =>
    calculationKeys.some((key) => {
        const credits = Array.isArray(buildNote?.[key])
            ? buildNote[key]
            : [buildNote?.[key]];

        return credits.some((credit) => credit?.author && credit?.link);
    });

const buildHasItemNotes = (notes: any) =>
    [
        notes?.lightCones?.items,

        notes?.relics?.sets,
        notes?.relics?.mainstats,
        notes?.relics?.substats,
        notes?.recommendedStats?.items,

        notes?.traces?.items,
    ].some((items) => Array.isArray(items) && items.length > 0);

const noteMarkerExplanation = t(
    locale,
    'ui',
    'Note marker explanation',
    undefined,
    false,
);
const buildGuideLabel = t(locale, 'ui', 'Builds', undefined, false);
---

<CharacterPageLayout
    characterSlug={characterSlug}
    character={characterName}
    metadata={metadata}
    type={type}
    lang={currentLang}
    locale={locale}
    defaultBuildSlug={defaultBuildSlug}
    builds={builds.map((build) => ({
        slug: build.slug,
        name: build.name,
        isBest: build.isBest,
        buildNote: build.buildNote,
        hasCalculations: hasBuildCalculations(build.buildNote),
    }))}
>
    <div class="character-builds-layout" data-default-build={defaultBuildSlug}>
        <div class="build-list">
            {
                builds.map((build) => {
                    const buildContentId = `build-content-${build.slug}`;

                    const hasNoteMarkerHint = buildHasItemNotes(build.notes);

                    const isDefaultBuild = build.slug === defaultBuildSlug;

                    return (
                        <section
                            class={`build-card${isDefaultBuild ? ' open' : ''}`}
                            data-build-panel
                            data-id={build.slug}
                            id={buildContentId}
                            aria-hidden={isDefaultBuild ? 'false' : 'true'}
                            hidden={!isDefaultBuild}
                        >
                            <div class="build-content">
                                <details
                                    class="card section-collapse build-guide-section"
                                    open
                                >
                                    <summary class="section-collapse-summary">
                                        <h2>{buildGuideLabel}</h2>

                                        <span
                                            class="section-collapse-chevron"
                                            aria-hidden="true"
                                        />
                                    </summary>

                                    <div class="section-collapse-body">
                                        {hasNoteMarkerHint && (
                                            <div class="build-note-hint">
                                                <span
                                                    class="note-marker-text"
                                                    aria-hidden="true"
                                                >
                                                    ⓘ
                                                </span>

                                                <span>
                                                    {noteMarkerExplanation}
                                                </span>
                                            </div>
                                        )}

                                        <div class="grid">
                                            {build.lightCones && (
                                                <LightCone
                                                    lightCones={
                                                        build.lightCones
                                                    }
                                                    locale={locale}
                                                    lang={currentLang}
                                                />
                                            )}

                                            {build.relics.sets && (
                                                <Relic
                                                    relics={build.relics}
                                                    locale={locale}
                                                    lang={currentLang}
                                                />
                                            )}

                                            {build.relics.mainstats &&
                                                build.relics.substats && (
                                                    <RelicStats
                                                        relics={build.relics}
                                                        locale={locale}
                                                    />
                                                )}

                                            {(build.recommendedStats ||
                                                build.traces) && (
                                                <div class="stats-traces-column">
                                                    {build.recommendedStats && (
                                                        <RecommendedStats
                                                            stats={
                                                                build.recommendedStats
                                                            }
                                                            locale={locale}
                                                        />
                                                    )}

                                                    {build.traces && (
                                                        <Trace
                                                            traces={
                                                                build.traces
                                                            }
                                                            locale={locale}
                                                            characterData={
                                                                characterData
                                                            }
                                                        />
                                                    )}
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </details>

                                <Notes
                                    notes={build.notes}
                                    buildNote={build.buildNote}
                                    locale={locale}
                                />
                            </div>
                        </section>
                    );
                })
            }
        </div>
    </div>

    {
        characterData && (
            <CharacterInfo character={characterData} locale={locale} />
        )
    }
</CharacterPageLayout>

{
    import.meta.env.DEV && warnings.length > 0 ? (
        <script
            is:inline
            set:html={`const warnings = ${JSON.stringify(
                warnings,
            )}; warnings.forEach((warning) => console.warn(warning));`}
        />
    ) : null
}
<script>
    import '../../scripts/build-selector';
    import '../../scripts/info-popover';
    import '../../scripts/note-highlight';
</script>
